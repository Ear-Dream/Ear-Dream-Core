# API 서버 설정. 이 파일을 `.env` 로 복사해서 쓴다 (`.env` 는 .gitignore 대상).
# 모든 설정은 `EAR_DREAM_` 접두를 쓴다 — 전체 목록은 app/core/config.py 참조.
#
# 여기 없는 값은 전부 코드 기본값으로 동작한다. 지금 이 파일이 다루는 건
# **단어열 → 문장 변환 LLM** 하나뿐이고, 그것도 안 켜면 규칙 폴백으로 돈다.

# ---- 단어열 → 문장 변환 LLM
#
# 개발 기계에 따라 백엔드가 갈린다. 둘 다 OpenAI 호환 /chat/completions 라
# 갈리는 건 아래 두 줄(주소·모델 ID)뿐이다. 자세한 건 README 「단어열 → 문장 변환」.
#
# 켜 두고 서버가 없으면 요청마다 연결 실패 → 규칙 폴백이다 (200 유지, 경고 로그).
# 아예 안 쓸 거면 false 로 두면 시도 자체를 안 한다.
EAR_DREAM_SENTENCE_LLM_ENABLED=true

# [Windows / WSL + NVIDIA GPU] vLLM — 원본 레포가 검증한 환경
EAR_DREAM_SENTENCE_LLM_BASE_URL=http://localhost:8001/v1
EAR_DREAM_SENTENCE_LLM_MODEL=Qwen/Qwen3-4B

# [macOS] Ollama — vLLM 이 CUDA 전용이라 맥에서는 이쪽을 쓴다
#   ollama pull qwen3:4b
# 아래 4줄은 한 세트다. 뒤 두 줄이 빠지면 매 요청 폴백한다 (README 「개발 기계별
# LLM 백엔드」에 실측 근거):
#   - REASONING_EFFORT: qwen3 는 thinking 모델. Ollama 는 vLLM 의
#     chat_template_kwargs.enable_thinking 을 무시하므로 이 필드로만 꺼진다
#   - STRUCTURED_OUTPUT: thinking 을 끈 4B 는 프롬프트만으로 출력 형식을 못 지킨다
#     (2단계가 분류 대신 입력을 되돌려줌). response_format 을 json_schema 로 바꿔
#     출력 계약을 강제한다 — 스키마는 코드에서 파생되고 프롬프트는 안 건드린다
# EAR_DREAM_SENTENCE_LLM_BASE_URL=http://localhost:11434/v1
# EAR_DREAM_SENTENCE_LLM_MODEL=qwen3:4b
# EAR_DREAM_SENTENCE_LLM_REASONING_EFFORT=none
# EAR_DREAM_SENTENCE_LLM_STRUCTURED_OUTPUT=true

# [다른 기계의 GPU 를 LAN 으로 쓸 때] 그 기계 IP 로 바꾸고 vLLM 을 --host 0.0.0.0 로 띄운다
# EAR_DREAM_SENTENCE_LLM_BASE_URL=http://192.168.0.20:8001/v1

# 감정·말투 2단계 분류. 끄면 요청당 LLM 추론이 2회 → 1회로 줄고 태그는 기본값이 된다.
# EAR_DREAM_SENTENCE_LLM_TAGS_ENABLED=false

# 응답 대기 상한(초). 프론트 상한 15s 보다 먼저 끊어져 폴백이 돌게 잡은 임시값.
# EAR_DREAM_SENTENCE_LLM_TIMEOUT_SECONDS=10
