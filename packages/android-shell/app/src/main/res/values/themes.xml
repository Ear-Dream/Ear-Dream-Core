<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        ActionBar 를 두지 않는다 — 화면 위쪽을 앱 자신의 AppBar 가 쓰고, 카메라 프리뷰가
        세로 화각을 최대한 써야 한다.

        windowBackground 은 첫 화면의 폴백색(features/home/backgroundTint.ts 의
        HOME_FALLBACK_COLOR)과 같다. WebView 가 첫 프레임을 그리기 전의 흰 번쩍임을 없앤다.
    -->
    <style name="Theme.EarDreamShell" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/brand_home_fallback</item>
        <item name="android:statusBarColor">@color/brand_home_fallback</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
