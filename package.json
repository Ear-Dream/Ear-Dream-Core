{
  "name": "ear-dream-core",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:app": "pnpm --filter @ear-dream/app dev",
    "dev:web": "pnpm setup:mediapipe && pnpm --filter @ear-dream/app web",
    "setup:mediapipe": "node scripts/setup-mediapipe-assets.mjs",
    "dev:api": "cd packages/ear-dream-api && uv run fastapi dev app/main.py",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint:api": "cd packages/ear-dream-api && uv run ruff check .",
    "test:api": "cd packages/ear-dream-api && uv run pytest",
    "generate:api-types": "node scripts/generate-api-types.mjs"
  }
}
